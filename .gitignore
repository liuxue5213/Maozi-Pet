# ============================================================
# 帽子AI宠物 - Git 忽略规则
# 安全第一：所有密钥、环境变量、构建产物一律不入库
# ============================================================

# --- 依赖 ---
node_modules/
.pnp/
.pnp.js
.yarn/install-state.gz
.yarn/unplugged/

# --- 环境变量（最高优先级，绝不上传） ---
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
*.pem
*.key

# --- 构建产物 ---
dist/
build/
web-build/
.expo/
.expo-shared/
*.apk
*.aab
*.ipa
*.tar.gz

# --- 调试日志 ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# --- 系统文件 ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- IDE ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- 测试覆盖率 ---
coverage/
.nyc_output/

# --- 数据库文件（持久化数据不入库） ---
backend/data/
*.db
*.db-shm
*.db-wal

# --- 临时文件 ---
tmp/
temp/
*.tmp

# Expo prebuild 原生工程（CI 上自动生成）
frontend/android/

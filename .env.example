# ============================================================
# 帽子AI宠物 - 环境变量模板
# 复制此文件为 .env 并填入真实值，切勿提交 .env 到仓库
# ============================================================

# --- 后端服务 ---
SERVER_PORT=60235
NODE_ENV=development

# --- 阿里百炼 AI ---
# 在阿里云百炼控制台获取 API Key
BAILIAN_API_KEY=your_bailian_api_key_here
BAILIAN_BASE_URL=https://llm-xxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus

# --- 数据库 (可选，MVP 可用 SQLite 本地存储) ---
DATABASE_URL=./data/maozi-pet.db

# --- 前端 API 指向 ---
# 开发环境指向本机，生产环境指向你的服务器
API_BASE_URL=http://localhost:60235/api

# --- JWT 密钥（用于用户 Token 签名，生产环境务必更换随机字符串） ---
JWT_SECRET=your_random_jwt_secret_here_min_32_chars

# --- CORS 允许的域名（逗号分隔，生产环境必须指定） ---
# 开发模式用 *，生产模式必须限制：https://yourdomain.com
ALLOWED_ORIGINS=*

# --- 图片生成 (智谱，仅开发/构建时使用) ---
ZHIPU_API_KEY=your_zhipu_api_key_here

# --- 推送服务 (Expo Push) ---
EXPO_ACCESS_TOKEN=your_expo_access_token_here
